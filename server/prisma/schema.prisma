generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum HeroStyle {
  SOLID
  GRADIENT
  IMAGE
}

enum Plan {
  BASIC
  PRO
}

enum Role {
  USER
  ADMIN
}

enum OfferingCategory {
  DAILY_RITUAL
  FESTIVAL
  ARCHANA
  ANNADANAM
  DONATION
  SPECIAL_SEVA
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Temple {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identity
  name     String
  location String
  tagline  String

  // Branding
  logoUrl      String?
  heroImageUrl String?
  accentColor  String  @default("#C8590A")

  // Hero section
  heroStyle          HeroStyle @default(SOLID)
  heroOverlayOpacity Int       @default(40)
  showOmSymbol       Boolean   @default(true)
  showLotusDivider   Boolean   @default(true)

  // Announcement banner
  announcementEnabled Boolean @default(false)
  announcementText    String?
  announcementColor   String?

  // Contact & social
  footerMessage String?
  phone         String?
  email         String?
  address       String?
  facebookUrl   String?
  instagramUrl  String?
  youtubeUrl    String?

  // Razorpay
  razorpayKeyId         String?
  razorpayKeySecret     String?
  razorpayWebhookSecret String?

  // Subscription
  plan     Plan    @default(BASIC)
  isActive Boolean @default(true)

  offerings Offering[]
  users     User[]
  orders    Order[]
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templeId String
  temple   Temple @relation(fields: [templeId], references: [id])

  name         String
  email        String
  mobile       String?
  passwordHash String?

  role      Role    @default(USER)
  gothram   String?
  nakshatra String?

  isGuest   Boolean @default(false)
  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  notes       String?
  lastLoginAt DateTime?

  orders Order[]

  @@unique([email, templeId])
}

model Offering {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templeId String
  temple   Temple @relation(fields: [templeId], references: [id])

  name        String
  description String
  amount      Decimal          @db.Decimal(10, 2)
  category    OfferingCategory
  emoji       String           @default("🪔")

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  orders Order[]

  @@index([templeId, isActive])
}

model Order {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templeId String
  temple   Temple @relation(fields: [templeId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id])

  // Guest details (when userId is null)
  guestName   String?
  guestEmail  String?
  guestMobile String?

  // Devotee details
  devoteeName         String?
  gothram             String?
  nakshatra           String?
  specialInstructions String?

  amount Decimal @db.Decimal(10, 2)

  // Razorpay
  razorpayOrderId   String? @unique
  razorpayPaymentId String?
  razorpaySignature String?

  status        OrderStatus @default(CREATED)
  paymentMethod String?
  receiptSent   Boolean     @default(false)

  @@index([templeId, createdAt(sort: Desc)])
}
