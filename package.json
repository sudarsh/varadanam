{
  "name": "varadanam",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client-admin",
    "client-user",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client-admin\" \"npm run dev --workspace=client-user\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:admin": "npm run dev --workspace=client-admin",
    "dev:user": "npm run dev --workspace=client-user",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.2.5"
  }
}
